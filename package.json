{
  "name": "markanban",
  "version": "0.1.0",
  "description": "A kanban board driven by a folder of markdown files",
  "type": "module",
  "bin": {
    "markanban": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "biome lint && markdownlint-cli2 && fallow dead-code && fallow dupes --fail-on-issues",
    "check": "npm run lint && tsc -p tsconfig.check.json && npm test",
    "start": "node src/cli.ts",
    "demo": "node src/demo.ts"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "fallow": "3.42.0",
    "markdownlint": "0.42.1",
    "markdownlint-cli2": "0.24.1",
    "typescript": "^7.0.2"
  }
}
